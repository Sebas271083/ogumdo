PORT=4000
# URL pública del sitio: se usa en el sitemap, los links canónicos y las vistas previas al compartir
SITE_URL=https://ogumdo.com.ar
FRONTEND_ORIGIN=http://localhost:5173

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=taekwondo

# Usuario administrador que crea `npm run init-db` (solo si la tabla usuarios está vacía)
ADMIN_EMAIL=admin@escuela.com
ADMIN_PASSWORD=cambiar123

# En producción (HTTPS) poner NODE_ENV=production para que la cookie de sesión sea Secure
NODE_ENV=development

# Notificaciones push: generá un par con `npm run vapid` (una sola vez; si cambian, hay que volver a activar en cada celular)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@ogumdo.com.ar
# Cuántas horas antes de cada clase se manda el recordatorio
RECORDATORIO_HORAS_ANTES=3
